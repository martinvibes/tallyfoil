# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# Database: PGlite locally when unset; Neon (Postgres) URL in production.
# DATABASE_URL=

# Model. Any OpenAI-compatible endpoint works. For DeepSeek:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# AGENT_ENGINE=ai-sdk:openai
# AGENT_MODEL=deepseek-chat
# Pin AGENT_MODEL to a non-reasoning model id: for gpt-5+/o-series ids the OpenAI SDK
# sends the system prompt as role "developer", which DeepSeek rejects.
# Or use ANTHROPIC_API_KEY, or connect Builder.io from the chat panel.
